<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Tests run quickly; no need to pass TestContext.CancellationToken to every call. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TicketShine.Support.Core\TicketShine.Support.Core.csproj" />
    <ProjectReference Include="..\..\src\TicketShine.Support.Infrastructure\TicketShine.Support.Infrastructure.csproj" />
    <!-- Build the MCP server before testing so it can run as a real child process over stdio. -->
    <ProjectReference Include="..\..\src\TicketShine.Support.McpServer\TicketShine.Support.McpServer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\TicketShine.Support.Gmail\TicketShine.Support.Gmail.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
